[Unit]
Description=VW day/night policy controller (experimental, read-only by default)
After=vw-hmi.service

[Service]
Type=simple
WorkingDirectory=/data/vw-daynight
ExecStart=/data/vw-daynight/daynight --config /data/vw-daynight/config.json run
Restart=on-failure
RestartSec=30
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
